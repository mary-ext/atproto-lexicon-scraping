{
	"authority": "did:plc:4tr5dqti7nmu6g2czpthntak",
	"schema": {
		"id": "tech.tokimeki.takibi.log",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"createdAt"
					],
					"properties": {
						"createdAt": {
							"type": "string",
							"format": "datetime"
						},
						"visibleSparks": {
							"type": "array",
							"items": {
								"ref": "#sparkRef",
								"type": "ref"
							},
							"maxLength": 20,
							"description": "Sparks visible at the moment of adding wood, with elapsed time for decay scoring"
						}
					}
				},
				"description": "A log record - adding wood to the fire. Implicitly records visible sparks as a form of 'silent appreciation'."
			},
			"sparkRef": {
				"type": "object",
				"required": [
					"spark",
					"elapsed"
				],
				"properties": {
					"spark": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref",
						"description": "Strong reference to the spark record"
					},
					"elapsed": {
						"type": "integer",
						"maximum": 10000,
						"minimum": 0,
						"description": "Milliseconds since the spark appeared on screen (0-10000)"
					}
				},
				"description": "Reference to a visible spark with timing information"
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1768954709804
	},
	"references": {
		"main": [
			"com.atproto.repo.strongRef"
		],
		"sparkRef": [
			"com.atproto.repo.strongRef"
		]
	}
}