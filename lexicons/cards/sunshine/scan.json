{
	"authority": "did:web:sunshine.cards",
	"schema": {
		"id": "cards.sunshine.scan",
		"defs": {
			"main": {
				"key": "any",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"card",
						"counter",
						"createdAt",
						"signatures"
					],
					"properties": {
						"card": {
							"type": "string",
							"format": "at-uri",
							"description": "The scanned card's public record."
						},
						"counter": {
							"type": "integer",
							"maximum": 16777215,
							"minimum": 1,
							"description": "The tag's read counter for this tap."
						},
						"createdAt": {
							"type": "string",
							"format": "datetime"
						},
						"signatures": {
							"type": "array",
							"items": {
								"refs": [
									"#signature"
								],
								"type": "union"
							},
							"minLength": 1
						}
					}
				},
				"description": "Proof that this repo's owner scanned a Sunshine Card, signed by the instance that checked the tap. The record key is <creator DID>:<UID>:<counter>."
			},
			"signature": {
				"type": "object",
				"required": [
					"key",
					"issuer",
					"cid",
					"signature"
				],
				"properties": {
					"cid": {
						"type": "string",
						"format": "cid"
					},
					"key": {
						"type": "string",
						"maxLength": 2048,
						"description": "DID URL of the signing key, eg. did:web:sunshine.cards#attestation."
					},
					"issuer": {
						"type": "string",
						"format": "did"
					},
					"signature": {
						"type": "bytes",
						"maxLength": 64,
						"minLength": 64
					}
				},
				"description": "A badge.blue inline signature: https://badge.blue"
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1791868100772
	},
	"references": {
		"main": [],
		"signature": []
	}
}