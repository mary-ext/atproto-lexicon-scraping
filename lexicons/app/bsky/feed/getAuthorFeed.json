	"schema": {
		"id": "app.bsky.feed.getAuthorFeed",
		"defs": {
			"main": {
				"type": "query",
				"errors": [
					{
						"name": "BlockedActor"
					},
					{
						"name": "BlockedByActor"
					}
				],
				"output": {
					"schema": {
						"type": "object",
						"required": [
							"feed"
						],
						"properties": {
							"feed": {
								"type": "array",
								"items": {
									"ref": "app.bsky.feed.defs#feedViewPost",
									"type": "ref"
								}
							},
							"cursor": {
								"type": "string"
							}
						}
					},
					"encoding": "application/json"
				},
				"parameters": {
					"type": "params",
					"required": [
						"actor"
					],
					"properties": {
						"actor": {
							"type": "string",
							"format": "at-identifier"
						},
						"limit": {
							"type": "integer",
							"default": 50,
							"maximum": 100,
							"minimum": 1
						},
						"cursor": {
							"type": "string"
						},
						"filter": {
							"type": "string",
							"default": "posts_with_replies",
