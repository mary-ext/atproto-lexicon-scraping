			"app.bsky.actor.defs",
			"app.bsky.embed.defs",
			"app.bsky.embed.external",
			"app.bsky.embed.images",
			"app.bsky.embed.record",
			"app.bsky.embed.recordWithMedia",
			"app.bsky.embed.video",
			"app.bsky.feed.defs",
			"app.bsky.graph.defs",
			"app.bsky.labeler.defs",
			"app.bsky.richtext.facet",
