{
	"authority": "did:plc:xk3xpcauatfephlieonmluh4",
	"schema": {
		"id": "app.protoimsg.chat.presence",
		"defs": {
			"main": {
				"key": "literal:self",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"status",
						"updatedAt"
					],
					"properties": {
						"status": {
							"type": "string",
							"description": "Current presence status.",
							"knownValues": [
								"online",
								"away",
								"idle",
								"offline",
								"invisible"
							]
						},
						"updatedAt": {
							"type": "string",
							"format": "datetime",
							"description": "When presence was last updated."
						},
						"awayMessage": {
							"type": "string",
							"maxLength": 300,
							"description": "Custom away message / status text."
						}
					}
				},
				"description": "User's current presence status. Lives in their repo, updated by their client. IMPORTANT: visibleTo is intentionally excluded — it is a privacy preference and must remain server-side only. Writing it to the PDS would publicly expose who the user is hiding from."
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
