		"defs": {
			"main": {
				"type": "procedure",
				"input": {
					"schema": {
						"type": "object",
						"required": [
							"rkey",
							"record"
						],
						"properties": {
							"rkey": {
								"type": "string",
								"format": "record-key",
								"description": "The record key (TID) for this note."
							},
							"record": {
