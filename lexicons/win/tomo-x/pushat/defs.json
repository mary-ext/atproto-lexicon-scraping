{
	"authority": "did:plc:qcwvyds5tixmcwkwrg3hxgxd",
	"schema": {
		"id": "win.tomo-x.pushat.defs",
		"defs": {
			"deviceList": {
				"type": "array",
				"items": {
					"ref": "#deviceListItem",
					"type": "ref"
				}
			},
			"notifyBody": {
				"type": "object",
				"required": [
					"title",
					"body"
				],
				"properties": {
					"body": {
						"type": "string",
						"description": "Body text of the notification."
					},
					"icon": {
						"type": "string",
						"format": "uri",
						"description": "The URI of the icon displayed in the notification."
					},
					"link": {
						"type": "string",
						"format": "uri",
						"description": "Experimental — do not use. The URI to open when the notification is clicked."
					},
					"title": {
						"type": "string",
						"description": "Title text of the notification."
					}
				}
			},
			"deviceListItem": {
				"type": "object",
				"required": [
					"name",
					"id",
					"current"
				],
				"properties": {
					"id": {
						"type": "string",
						"format": "tid"
					},
					"name": {
						"type": "string",
						"maxLength": 300,
						"maxGraphemes": 30
					},
					"current": {
						"type": "boolean",
						"default": false
					}
				}
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1760227745051
	},
	"references": {
