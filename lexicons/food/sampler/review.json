				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"place",
						"createdAt"
					],
					"properties": {
						"text": {
							"type": "string",
							"maxLength": 5000,
							"description": "Review text"
						},
						"place": {
							"type": "string",
							"format": "at-uri",
							"description": "Reference to a food.sampler.place record"
						},
						"photos": {
							"type": "array",
							"items": {
								"type": "blob",
								"accept": [
									"image/jpeg",
									"image/png",
									"image/webp"
								],
								"maxSize": 1000000
							},
							"maxLength": 4,
							"description": "Up to 4 photos"
						},
						"rating": {
							"type": "integer",
							"maximum": 5,
							"minimum": 1,
							"description": "Star rating (1-5)"
						},
						"createdAt": {
							"type": "string",
							"format": "datetime"
						}
					}
				},
				"description": "A review of a place. References a place record."
			}
		},
