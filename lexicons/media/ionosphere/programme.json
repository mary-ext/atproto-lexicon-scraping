{
	"authority": "did:plc:krl7x6q6rjc6qcoix5qu6fiv",
	"schema": {
		"id": "media.ionosphere.programme",
		"defs": {
			"main": {
				"key": "any",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"ionosphere",
						"name",
						"language"
					],
					"properties": {
						"icon": {
							"type": "blob",
							"accept": [
								"image/*"
							]
						},
						"name": {
							"type": "string",
							"maxGraphemes": 128
						},
						"genres": {
							"type": "array",
							"items": {
								"ref": "media.ionosphere.defs#genre",
								"type": "ref"
							}
						},
						"credits": {
							"type": "array",
							"items": {
								"ref": "media.ionosphere.defs#credit",
								"type": "ref"
							}
						},
						"delivery": {
							"type": "array",
							"items": {
								"refs": [
									"media.ionosphere.defs#broadcast",
									"media.ionosphere.defs#recording"
								],
								"type": "union",
								"closed": true
							}
						},
						"keywords": {
							"type": "array",
							"items": {
								"type": "string",
								"maxLength": 128
							}
						},
						"language": {
							"type": "string",
							"format": "language",
							"description": "The language of the string values in this record. NOT the language of the content"
						},
						"memberOf": {
							"type": "array",
							"items": {
								"type": "string",
								"format": "at-uri"
							},
							"description": "A list of groups this record is a member of"
						},
						"ionosphere": {
							"type": "string",
							"maxLength": 128,
							"description": "Version identifier"
						},
						"description": {
							"type": "string",
							"maxLength": 128
						},
						"presentationLanguage": {
							"type": "string",
							"format": "language"
						}
					}
				},
				"description": "A programme represents an individual piece of media. It does not represent a long-running show."
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1770078164490
	},
	"references": {
		"main": [
			"media.ionosphere.defs"
		]
	}
}