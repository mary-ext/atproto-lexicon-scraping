							"type": "string",
							"format": "did"
						},
						"limit": {
							"type": "integer",
							"default": 50,
							"maximum": 100,
							"minimum": 1
						},
						"cursor": {
							"type": "string"
						}
					}
				},
				"description": "Get accounts that share some matching threat signatures with the root account."
