{
	"authority": "did:plc:revjuqmkvrw6fnkxppqtszpv",
	"schema": {
		"id": "blog.pckt.blog",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"name"
					],
					"properties": {
						"rss": {
							"type": "string",
							"format": "uri"
						},
						"url": {
							"type": "string",
							"format": "uri"
						},
						"icon": {
							"type": "blob",
							"accept": [
								"image/*"
							]
						},
						"name": {
							"type": "string"
						},
						"theme": {
							"ref": "#theme",
							"type": "ref"
						},
						"updatedAt": {
							"type": "string",
							"format": "datetime"
						},
						"description": {
							"type": "string"
						}
					}
				}
			},
			"theme": {
				"type": "object",
				"properties": {
					"dark": {
						"ref": "#palette",
						"type": "ref"
					},
					"font": {
						"type": "string"
					},
					"light": {
						"ref": "#palette",
						"type": "ref"
					}
				}
			},
			"palette": {
				"type": "object",
				"properties": {
					"link": {
						"type": "string"
					},
					"text": {
						"type": "string"
					},
					"accent": {
						"type": "string"
					},
					"background": {
						"type": "string"
					},
					"surfaceHover": {
						"type": "string"
					}
				}
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1,
		"description": "A blog record type for publishing blog metadata and configuration. Contains name, description, URL, RSS feed, theme settings, and an icon."
	},
	"meta": {
		"indexedAt": 1760078004263
	}
}