{
	"authority": "did:plc:revjuqmkvrw6fnkxppqtszpv",
	"schema": {
		"id": "blog.pckt.document",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"title",
						"blocks",
						"url",
						"blog"
					],
					"properties": {
						"url": {
							"type": "string",
							"format": "uri"
						},
						"blog": {
							"ref": "com.atproto.repo.strongRef",
							"type": "ref"
						},
						"tags": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"cover": {
							"type": "blob",
							"accept": [
								"image/*"
							]
						},
						"title": {
							"type": "string"
						},
						"blocks": {
							"type": "array",
							"items": {
								"refs": [
									"blog.pckt.block.paragraph",
									"blog.pckt.block.heading",
									"blog.pckt.block.image",
									"blog.pckt.block.bulletList",
									"blog.pckt.block.orderedList",
									"blog.pckt.block.listItem",
									"blog.pckt.block.taskList",
									"blog.pckt.block.taskItem",
									"blog.pckt.block.blockquote",
									"blog.pckt.block.codeBlock",
									"blog.pckt.block.horizontalRule",
									"blog.pckt.block.blueskyEmbed"
								],
								"type": "union",
								"closed": false
							}
						},
						"images": {
							"type": "array",
							"items": {
								"type": "blob",
								"accept": [
									"image/*"
								]
							}
						},
						"bodyPlain": {
							"type": "string"
						},
						"updatedAt": {
							"type": "string",
							"format": "datetime"
						},
						"publishedAt": {
							"type": "string",
							"format": "datetime"
						}
					}
				}
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1,
		"description": "A blog document record. References a parent blog, and contains document title, body content, URL, tags, cover image, inline images, and timestamps."
	},
	"meta": {
		"indexedAt": 1762388137210
	},
	"references": {
		"main": [
			"blog.pckt.block.blockquote",
			"blog.pckt.block.blueskyEmbed",
			"blog.pckt.block.bulletList",
			"blog.pckt.block.codeBlock",
			"blog.pckt.block.heading",
			"blog.pckt.block.horizontalRule",
			"blog.pckt.block.image",
			"blog.pckt.block.listItem",
			"blog.pckt.block.orderedList",
			"blog.pckt.block.paragraph",
			"blog.pckt.block.taskItem",
			"blog.pckt.block.taskList",
			"com.atproto.repo.strongRef"
		]
	}
}