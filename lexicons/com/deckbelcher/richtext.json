			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"listItem": [
			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"codeBlock": [],
		"headingBlock": [
			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"paragraphBlock": [
			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"bulletListBlock": [
			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"orderedListBlock": [
			"com.deckbelcher.defs",
			"com.deckbelcher.richtext.facet"
		],
		"horizontalRuleBlock": []
	}
}