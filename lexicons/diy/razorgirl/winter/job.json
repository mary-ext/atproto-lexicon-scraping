{
	"authority": "did:plc:ezyi5vr2kuq7l5nnv53nb56m",
	"schema": {
		"id": "diy.razorgirl.winter.job",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"name",
						"instructions",
						"schedule",
						"createdAt"
					],
					"properties": {
						"name": {
							"type": "string",
							"maxLength": 128
						},
						"status": {
							"type": "string",
							"default": "pending",
							"knownValues": [
								"pending",
								"running",
								"completed",
								"failed"
							]
						},
						"lastRun": {
							"type": "string",
							"format": "datetime"
						},
						"nextRun": {
							"type": "string",
							"format": "datetime"
						},
						"schedule": {
							"refs": [
								"#onceSchedule",
								"#intervalSchedule"
							],
							"type": "union"
						},
						"createdAt": {
							"type": "string",
							"format": "datetime"
						},
						"failureCount": {
							"type": "integer",
							"default": 0
						},
						"instructions": {
							"type": "string",
							"maxLength": 50000
						}
					}
				}
			},
			"onceSchedule": {
				"type": "object",
				"required": [
					"type",
					"runAt"
				],
				"properties": {
					"type": {
						"type": "string",
						"const": "once"
					},
					"runAt": {
						"type": "string",
						"format": "datetime"
					}
				}
			},
			"intervalSchedule": {
				"type": "object",
				"required": [
					"type",
					"seconds"
				],
				"properties": {
					"type": {
						"type": "string",
						"const": "interval"
					},
					"seconds": {
						"type": "integer"
					}
				}
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1,
		"description": "Scheduled task with natural-language instructions. Supports one-time and recurring schedules."
	},
	"meta": {
		"indexedAt": 1771633345512
	},
	"references": {
		"main": [],
		"onceSchedule": [],
		"intervalSchedule": []
	}
}