{
	"authority": "did:plc:4v4y5r3lwsbtmsxhile2ljac",
	"schema": {
		"id": "chat.bsky.convo.defs",
		"defs": {
			"convoView": {
				"type": "object",
				"required": [
					"id",
					"rev",
					"members",
					"muted",
					"unreadCount"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"rev": {
						"type": "string"
					},
					"muted": {
						"type": "boolean"
					},
					"status": {
						"type": "string",
						"knownValues": [
							"request",
							"accepted"
						]
					},
					"members": {
						"type": "array",
						"items": {
							"ref": "chat.bsky.actor.defs#profileViewBasic",
							"type": "ref"
						}
					},
					"lastMessage": {
						"refs": [
							"#messageView",
							"#deletedMessageView"
						],
						"type": "union"
					},
					"unreadCount": {
						"type": "integer"
					},
					"lastReaction": {
						"refs": [
							"#messageAndReactionView"
						],
						"type": "union"
					}
				}
			},
			"messageRef": {
				"type": "object",
