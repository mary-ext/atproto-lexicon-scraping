							"refs": [
								"#external",
								"#template"
							],
							"type": "union",
							"description": "How this component is rendered. Omit for primitives rendered by the host."
						},
						"type": {
							"type": "string",
							"format": "nsid",
							"description": "NSID this component implements (also the XRPC procedure)"
						},
						"imports": {
							"type": "array",
							"items": {
								"ref": "#import",
								"type": "ref"
