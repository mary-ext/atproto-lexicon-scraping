{
	"authority": "did:plc:gezmsuy32xcaxguhveblhsz3",
	"schema": {
		"id": "net.jbsm.jb.reminder",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"createdAt",
						"triggerAt",
						"subject",
						"requester"
					],
					"properties": {
						"subject": {
							"type": "string",
							"maxLength": 1000,
							"description": "The reminder message/content"
						},
						"occurred": {
							"type": "boolean",
							"default": false,
							"description": "Whether the reminder has been triggered"
						},
						"createdAt": {
							"type": "string",
							"format": "datetime",
							"description": "Timestamp when the reminder was created"
						},
						"originUri": {
							"type": "string",
							"format": "at-uri",
							"description": "AT-URI of the original post/message that triggered this reminder"
						},
						"requester": {
							"type": "string",
							"format": "did",
							"description": "DID of the user who created the reminder"
						},
						"triggerAt": {
							"type": "string",
							"format": "datetime",
							"description": "Timestamp when the reminder should fire"
						}
					}
				},
				"description": "A reminder scheduled to trigger at a specific time"
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1769646054509
	},
	"references": {
		"main": []
	}
}