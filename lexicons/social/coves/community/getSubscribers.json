								}
							}
						}
					},
					"encoding": "application/json"
				},
				"parameters": {
					"type": "params",
					"required": [
						"community"
					],
					"properties": {
						"limit": {
							"type": "integer",
							"default": 50,
							"maximum": 100,
							"minimum": 1
