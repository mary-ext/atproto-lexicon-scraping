{
	"authority": "did:plc:dh5z4ffoxlugvbynwmef4e77",
	"schema": {
		"id": "social.flockfeeds.lexical.service",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"properties": {
						"url": {
							"type": "string",
							"format": "uri",
							"description": "URL of the item."
						},
						"logo": {
							"refs": [
								"social.flockfeeds.lexical.imageobject",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "An associated logo."
						},
						"name": {
							"type": "string",
							"description": "The name of the item."
						},
						"award": {
							"type": "string",
							"description": "An award won by or for this item."
						},
						"brand": {
							"refs": [
								"social.flockfeeds.lexical.organization",
								"social.flockfeeds.lexical.brand",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person."
						},
						"image": {
							"refs": [
								"social.flockfeeds.lexical.imageobject",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "An image of the item. This can be a [[URL]] or a fully described [[ImageObject]]."
						},
						"broker": {
							"refs": [
								"social.flockfeeds.lexical.person",
								"social.flockfeeds.lexical.organization",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "An entity that arranges for an exchange between a buyer and a seller.  In most cases a broker never acquires or releases ownership of a product or service involved in an exchange.  If it is not clear whether an entity is a broker, seller, or buyer, the latter two terms are preferred."
						},
						"offers": {
							"refs": [
								"social.flockfeeds.lexical.demand",
								"social.flockfeeds.lexical.offer",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "An offer to provide this item&#x2014;for example, an offer to sell a product, rent the DVD of a movie, perform a service, or give away tickets to an event. Use [[businessFunction]] to indicate the kind of transaction offered, i.e. sell, lease, etc. This property can also be used to describe a [[Demand]]. While this property is listed as expected on a number of common types, it can be used in others. In that case, using a second type, such as Product or a subtype of Product, can clarify the nature of the offer."
						},
						"review": {
							"refs": [
								"social.flockfeeds.lexical.review",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A review of the item."
						},
						"sameAs": {
							"type": "string",
							"format": "uri",
							"description": "URL of a reference Web page that unambiguously indicates the item's identity. E.g. the URL of the item's Wikipedia page, Wikidata entry, or official website."
						},
						"slogan": {
							"type": "string",
							"description": "A slogan or motto associated with the item."
						},
						"audience": {
							"refs": [
								"social.flockfeeds.lexical.audience",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "An intended audience, i.e. a group for whom something was created."
						},
						"category": {
							"refs": [
								"social.flockfeeds.lexical.physicalactivitycategory",
								"social.flockfeeds.lexical.categorycode",
								"social.flockfeeds.lexical.thing",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy."
						},
						"produces": {
							"refs": [
								"social.flockfeeds.lexical.thing",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The tangible thing generated by the service, e.g. a passport, permit, etc."
						},
						"provider": {
							"refs": [
								"social.flockfeeds.lexical.person",
								"social.flockfeeds.lexical.organization",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The service provider, service operator, or service performer; the goods producer. Another party (a seller) may offer those services or goods on behalf of the provider. A provider may also serve as the seller."
						},
						"subjectOf": {
							"refs": [
								"social.flockfeeds.lexical.event",
								"social.flockfeeds.lexical.creativework",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A CreativeWork or Event about this Thing."
						},
						"areaServed": {
							"refs": [
								"social.flockfeeds.lexical.geoshape",
								"social.flockfeeds.lexical.administrativearea",
								"social.flockfeeds.lexical.place",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The geographic area where a service or offered item is provided."
						},
						"identifier": {
							"refs": [
								"social.flockfeeds.lexical.propertyvalue",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The identifier property represents any kind of identifier for any kind of [[Thing]], such as ISBNs, GTIN codes, UUIDs etc. Schema.org provides dedicated properties for representing many of these, either as textual strings or as URL (URI) links. See [background notes](/docs/datamodel.html#identifierBg) for more details."
						},
						"description": {
							"refs": [
								"social.flockfeeds.lexical.textobject",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A description of the item."
						},
						"isRelatedTo": {
							"refs": [
								"social.flockfeeds.lexical.service",
								"social.flockfeeds.lexical.product",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A pointer to another, somehow related product (or multiple products)."
						},
						"isSimilarTo": {
							"refs": [
								"social.flockfeeds.lexical.service",
								"social.flockfeeds.lexical.product",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A pointer to another, functionally similar product (or multiple products)."
						},
						"serviceArea": {
							"refs": [
								"social.flockfeeds.lexical.administrativearea",
								"social.flockfeeds.lexical.geoshape",
								"social.flockfeeds.lexical.place",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The geographic area where the service is provided."
						},
						"serviceType": {
							"refs": [
								"social.flockfeeds.lexical.governmentbenefitstype",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The type of service being offered, e.g. veterans' benefits, emergency relief, etc."
						},
						"alternateName": {
							"type": "string",
							"description": "An alias for the item."
						},
						"serviceOutput": {
							"refs": [
								"social.flockfeeds.lexical.thing",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The tangible thing generated by the service, e.g. a passport, permit, etc."
						},
						"additionalType": {
							"type": "string",
							"description": "An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. Typically the value is a URI-identified RDF class, and in this case corresponds to the\n    use of rdf:type in RDF. Text values can be used sparingly, for cases where useful information can be added without their being an appropriate schema to reference. In the case of text values, the class label should follow the schema.org <a href=\"https://schema.org/docs/styleguide.html\">style guide</a>."
						},
						"hoursAvailable": {
							"refs": [
								"social.flockfeeds.lexical.openinghoursspecification",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The hours during which this service or contact is available."
						},
						"termsOfService": {
							"type": "string",
							"description": "Human-readable terms of service documentation."
						},
						"aggregateRating": {
							"refs": [
								"social.flockfeeds.lexical.aggregaterating",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The overall rating, based on a collection of reviews or ratings, of the item."
						},
						"hasOfferCatalog": {
							"refs": [
								"social.flockfeeds.lexical.offercatalog",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "Indicates an OfferCatalog listing for this Organization, Person, or Service."
						},
						"potentialAction": {
							"refs": [
								"social.flockfeeds.lexical.action",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "Indicates a potential Action, which describes an idealized action in which this thing would play an 'object' role."
						},
						"serviceAudience": {
							"refs": [
								"social.flockfeeds.lexical.audience",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "The audience eligible for this service."
						},
						"availableChannel": {
							"refs": [
								"social.flockfeeds.lexical.servicechannel",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "A means of accessing the service (e.g. a phone bank, a web site, a location, etc.)."
						},
						"hasCertification": {
							"refs": [
								"social.flockfeeds.lexical.certification",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "Certification information about a product, organization, service, place, or person."
						},
						"mainEntityOfPage": {
							"refs": [
								"social.flockfeeds.lexical.creativework",
								"social.flockfeeds.lexical.itemlist"
							],
							"type": "union",
							"description": "Indicates a page (or other CreativeWork) for which this thing is the main entity being described. See [background notes](/docs/datamodel.html#mainEntityBackground) for details."
						},
						"providerMobility": {
							"type": "string",
							"description": "Indicates the mobility of a provided service (e.g. 'static', 'dynamic')."
						},
						"disambiguatingDescription": {
							"type": "string",
							"description": "A sub property of description. A short description of the item used to disambiguate from other, similar items. Information from other properties (in particular, name) may be necessary for the description to be useful for disambiguation."
						}
					}
				},
				"description": "A service provided by an organization, e.g. delivery service, print services, etc."
			}
		},
