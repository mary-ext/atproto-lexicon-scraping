					"totalScore"
				],
				"properties": {
					"teamScore": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref",
						"description": "Reference to the team's detailed score record"
					},
					"totalScore": {
						"type": "integer",
						"minimum": 0,
						"description": "Team's total score"
