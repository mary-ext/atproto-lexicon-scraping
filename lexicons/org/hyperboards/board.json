{
	"authority": "did:plc:ndshualwvbeqns3sthtkhx2y",
	"schema": {
		"id": "org.hyperboards.board",
		"defs": {
			"main": {
				"key": "tid",
				"type": "record",
				"record": {
					"type": "object",
					"required": [
						"subject",
						"createdAt"
					],
					"properties": {
						"items": {
							"type": "array",
							"items": {
								"ref": "#boardItem",
								"type": "ref"
							},
							"description": "Per-item presentation overrides"
						},
						"config": {
							"ref": "#boardConfig",
							"type": "ref",
							"description": "Board-level visual configuration"
						},
						"subject": {
							"ref": "com.atproto.repo.strongRef",
							"type": "ref",
							"description": "StrongRef to the org.hypercerts.claim.activity or collection this board visualizes"
						},
						"createdAt": {
							"type": "string",
							"format": "datetime",
							"description": "Timestamp when the board record was created"
						}
					}
				},
				"description": "A hyperboard record — visual presentation wrapper for a hypercert activity or collection."
			},
			"boardItem": {
				"type": "object",
				"required": [
					"itemRef"
				],
				"properties": {
					"url": {
						"type": "string",
						"format": "uri",
						"description": "Link URL for this item"
					},
					"itemRef": {
						"ref": "com.atproto.repo.strongRef",
						"type": "ref",
						"description": "StrongRef to the contributor or activity being styled"
					},
					"videoUrl": {
						"type": "string",
						"format": "uri",
						"description": "Direct video or Instagram URL"
					},
					"displayName": {
						"type": "string",
						"maxLength": 640,
						"description": "Display name override for this item"
					},
					"isBlueprint": {
						"type": "boolean",
						"description": "Whether this item is a blueprint entry"
					},
					"circularImage": {
						"type": "boolean",
						"description": "Whether to render the contributor image as circular (default true)"
					},
					"hoverImageUrl": {
						"type": "string",
						"format": "uri",
						"description": "Image overlay shown on hover"
					},
					"hoverIframeUrl": {
						"type": "string",
						"format": "uri",
						"description": "Iframe shown on hover"
					}
				},
				"description": "Per-item presentation overrides for a contributor or activity within the board"
			},
			"boardConfig": {
				"type": "object",
				"properties": {
					"aspectRatio": {
						"type": "string",
						"maxLength": 10,
						"description": "Board aspect ratio (default '16:9')",
						"knownValues": [
							"16:9",
							"4:3",
							"1:1"
						]
					},
					"borderColor": {
						"type": "string",
						"maxLength": 9,
						"description": "Border hex color (e.g. '#000000')"
					},
					"backgroundType": {
						"type": "string",
						"maxLength": 10,
						"description": "The type of background to display",
						"knownValues": [
							"image",
							"iframe"
						]
					},
					"backgroundColor": {
						"type": "string",
						"maxLength": 9,
						"description": "Background hex color (e.g. '#ffffff')"
					},
					"backgroundImage": {
						"type": "string",
						"format": "uri",
						"description": "URI of the background image"
					},
					"grayscaleImages": {
						"type": "boolean",
						"description": "Whether to render contributor images in grayscale (default false)"
					},
					"backgroundOpacity": {
						"type": "string",
						"maxLength": 20,
						"description": "Background opacity as a string from '0' to '1' (string for precision)"
					},
					"backgroundGrayscale": {
						"type": "boolean",
						"description": "Whether to render the background in grayscale (default true)"
					},
					"backgroundIframeUrl": {
						"type": "string",
						"format": "uri",
						"description": "URI of the background iframe"
					}
				},
				"description": "Board-level visual configuration options"
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1771460616704
	},
	"references": {
		"main": [
			"com.atproto.repo.strongRef"
		],
		"boardItem": [
			"com.atproto.repo.strongRef"
		],
		"boardConfig": []
	}
}