{
	"authority": "did:plc:e4fjueijznwqm2yxvt7q4mba",
	"schema": {
		"id": "org.atsui.List",
		"defs": {
			"main": {
				"type": "procedure",
				"input": {
					"schema": {
						"type": "object",
						"required": [
							"uris",
							"item"
						],
						"properties": {
							"item": {
								"type": "string",
								"format": "nsid",
								"description": "Component NSID to render each item through."
							},
							"uris": {
								"type": "array",
								"items": {
									"type": "string",
									"format": "uri"
								},
								"description": "URIs to render (AT URIs or DID URIs)."
							},
							"loadMore": {
								"ref": "#loadMoreAction",
								"type": "ref",
								"description": "Descriptor for fetching the next page."
							}
						}
					},
					"encoding": "application/json"
				},
				"output": {
					"schema": {
						"ref": "at.inlay.defs#response",
						"type": "ref"
					},
					"encoding": "application/json"
				},
				"description": "Scrollable vertical list with infinite loading."
			},
			"loadMoreAction": {
				"type": "object",
				"required": [
					"procedure",
					"input"
				],
				"properties": {
					"input": {
						"type": "unknown",
						"description": "Input to pass to the procedure."
					},
					"procedure": {
						"type": "string",
						"format": "nsid",
						"description": "XRPC procedure to call for more items."
					}
				}
			},
			"loadMoreResponse": {
				"type": "object",
				"required": [
					"uris"
				],
				"properties": {
					"uris": {
						"type": "array",
						"items": {
							"type": "string",
							"format": "uri"
						}
					},
					"loadMore": {
						"ref": "#loadMoreAction",
						"type": "ref"
					}
				}
			}
		},
		"$type": "com.atproto.lexicon.schema",
		"lexicon": 1
	},
	"meta": {
		"indexedAt": 1771374195771
	},
	"references": {
		"main": [
			"at.inlay.defs"
		],
		"loadMoreAction": [],
		"loadMoreResponse": []
	}
}